# LifeLink AI — Environment Configuration Example

# Backend Settings
PROJECT_NAME="LifeLink AI"
VERSION="1.0.0"
ENVIRONMENT="SIMULATED"  # Options: DEMO, SIMULATED, CONNECTED_TO_HARDWARE
DATABASE_URL="sqlite:///./lifelink.db"
SECRET_KEY="lifelink-ai-secret-key-super-secure-production-ready-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Escalation & Detection Engine Parameters
ESCALATION_TIMEOUT_SECONDS=60
FALL_ACCEL_THRESHOLD=2.8
FREE_FALL_THRESHOLD=0.55
INACTIVITY_TIME_WINDOW=2.5
COOLDOWN_SECONDS=20

# Notification Providers (Optional - Leave blank for built-in local adapters)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FIREBASE_SERVER_KEY=""

# Frontend Settings
VITE_API_URL="http://localhost:8000"
